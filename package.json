{
  "name": "whatsapp-components",
  "private": true,
  "packageManager": "bun@1.3.5",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "bun run registry:build && bun run --filter @whatsapp-components/dashboard dev",
    "build": "bun run registry:build && bun run --filter @whatsapp-components/dashboard build",
    "registry:build": "shadcn build registry.json --output apps/dashboard/public/r",
    "typecheck": "tsc --noEmit && bun run --filter @whatsapp-components/dashboard typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "bun test tests"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/bun": "1.4.2",
    "@types/node": "26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "4.21.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "clsx": "2.1.1",
    "tailwind-merge": "3.7.0"
  },
  "license": "MIT"
}
